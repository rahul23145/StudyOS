<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card_light"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#CBD5E1" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_tune"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="⚡ CA Inter Routine Optimizer"
                android:textColor="@color/text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adapts dynamically to shifted tuition, evening gym, or late/early wake-up while guaranteeing ~11 to 12 hours of study."
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Live Impact Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#BAE6FD"
            app:cardBackgroundColor="#F0F9FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GUARANTEED STUDY TIME"
                        android:textColor="#0369A1"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveStudyHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0284C7"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="11h 35m" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveSubjectBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#0369A1"
                    android:textSize="11.5sp"
                    tools:text="Costing: 4h 36m • Audit: 3h 00m • Tuition: 1h 00m • Practice: 2h 59m" />

                <TextView
                    android:id="@+id/tvLiveSleepRecovery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp"
                    tools:text="🛌 Sleep Recovery: 7.5h (11:30 PM – 7:00 AM)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Wake Up Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Wake Up Time"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupWakeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0530"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:30 AM (Early)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0630"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:30 AM" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0700"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="07:00 AM (Standard)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0800"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:00 AM (Late)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0830"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:30 AM" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWake0900"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 2. Gym / Workout Shift -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Gym &amp; Physical Fitness Shift"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGymShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGymMorning"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Morning Gym (7:15 AM)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGymEvening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evening Gym / Run (6:00 PM)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGymNight"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Night Workout (8:30 PM)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGymNone"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rest Day / Skip Gym" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 3. Tuition Timing -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Tuition Class Timing"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTuitionShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTuitionEvening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Evening 6:00–7:00 PM (MWF)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTuitionMorning8"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morning 8:00–9:00 AM" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTuitionMorning10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morning 10:00–11:00 AM" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTuitionNone"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Tuition Today" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 4. Study Target (11 - 12h) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Target Daily Study Goal"
            android:textColor="@color/text_primary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStudyTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTarget110"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11.0 Hours" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTarget115"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="11.5 Hours (Standard)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTarget120"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.0 Hours (Deep Focus)" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetToStandard"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard MWF"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                app:strokeColor="@color/divider_light" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyOptimizedRoutine"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Apply Optimized Routine"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
