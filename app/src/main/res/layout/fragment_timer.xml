<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CA Inter Study Timer"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimerPresetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2-Hour Deep Study Block"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quick Presets Flow / Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetStudyBlock"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h Study Block"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetCosting"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Costing (2h 18m)"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetAudit"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audit (1h 30m)"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetBreak"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15m Break"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetTuition"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tuition (60m)" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Big Timer Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_light"
            app:cardBackgroundColor="@color/surface_card_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <!-- Progress Ring / Indicator -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circularTimerProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="220dp"
                    app:trackThickness="14dp"
                    app:trackCornerRadius="7dp"
                    app:trackColor="@color/divider_light"
                    app:indicatorColor="@color/primary"
                    tools:progress="75" />

                <TextView
                    android:id="@+id/tvTimerDigits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-140dp"
                    android:textColor="@color/text_primary_light"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    tools:text="02:00:00" />

                <TextView
                    android:id="@+id/tvTimerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="50dp"
                    android:textColor="@color/accent_emerald"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="FOCUSING" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTimer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="Reset"
                android:layout_marginEnd="12dp"
                app:icon="@drawable/ic_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartPauseTimer"
                style="@style/Widget.Material3.Button"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:text="Start"
                android:textSize="16sp"
                app:icon="@drawable/ic_play"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- Log Study Session Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogSession"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Session in Study Log"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_book"
            app:iconTint="@color/primary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
