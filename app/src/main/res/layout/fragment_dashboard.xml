<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Date & Streak Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDateDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary_light"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Monday, Nov 16, 2026" />

                <TextView
                    android:id="@+id/tvRoutineType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="MWF Routine • Tuition 6–7 PM • Costing 2x + Audit 2x" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Day Streak"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="6dp"
                    app:chipBackgroundColor="@color/accent_amber_light"
                    app:chipIcon="@drawable/ic_analytics"
                    app:chipIconTint="@color/accent_amber" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTotalHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h Total"
                    android:textColor="@color/secondary"
                    app:chipBackgroundColor="@color/surface_variant_light"
                    app:chipIcon="@drawable/ic_timer"
                    app:chipIconTint="@color/secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Daily Progress Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_light"
            app:cardBackgroundColor="@color/surface_card_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Daily Target Progress"
                        android:textColor="@color/text_primary_light"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_emerald"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="65%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressDaily"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    app:trackCornerRadius="5dp"
                    app:trackColor="@color/divider_light"
                    app:indicatorColor="@color/accent_emerald"
                    tools:progress="65" />

                <!-- Mini metrics row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvCostingDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/category_costing"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="1 / 2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Costing"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvAuditDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/category_audit"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="2 / 2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audit"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvStudyHoursLogged"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_emerald"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="6h 40m" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTotalStudyHoursAllTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="148h" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All-Time Total"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 7-Day Consistency Bar Graph -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/divider_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Study Consistency Graph"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <com.studyos.cainter.ui.common.StudyBarChartView
                    android:id="@+id/dashboardChart"
                    android:layout_width="match_parent"
                    android:layout_height="160dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Current / Next Focus Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE"
            app:cardBackgroundColor="#EFF6FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFocusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT FOCUS"
                    android:textColor="@color/secondary_variant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentActivityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Costing Lecture 1 (2h 18m)" />

                <TextView
                    android:id="@+id/tvCurrentActivityTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp"
                    tools:text="09:00 - 11:18 (138 mins) • Home to Study Room" />

                <TextView
                    android:id="@+id/tvUpNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp"
                    tools:text="Up Next: Study Room Break (11:18 - 11:30)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Today's Routine Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today\'s Activities"
                android:textColor="@color/text_primary_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTasksCompletedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                tools:text="8/15 Done" />
        </LinearLayout>

        <!-- Activities Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTodaySchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="5"
            tools:listitem="@layout/item_today_schedule" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
