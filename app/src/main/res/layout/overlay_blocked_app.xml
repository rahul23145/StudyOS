<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60F172A"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/divider_light"
        app:cardBackgroundColor="@color/surface_card_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Zero Distraction Mode"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvBlockedAppBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instagram is blocked!"
                android:textColor="@color/accent_rose"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Active Focus Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE FOCUS SESSION"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvOverlayTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Costing Lecture 1"
                    android:textColor="@color/text_primary_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvOverlayRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:45:20"
                    android:textColor="@color/secondary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distraction is the enemy of mastery. Stay focused and conquer your CA Inter target!"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayBackToStudy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Return to Focus Session"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_timer"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
