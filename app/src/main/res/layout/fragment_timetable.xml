<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Controls: Day Selector & Reset button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvDayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Monday Timetable" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScheduleType"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="CA Inter ▾"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="18dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/primary"
                app:iconSize="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetDefaults"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Reset"
                android:textColor="@color/accent_rose"
                android:textSize="12sp"
                app:icon="@drawable/ic_reset"
                app:iconTint="@color/accent_rose"
                app:iconSize="15dp" />
        </LinearLayout>

        <!-- Day Selector Chips (Mon-Sun) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMon"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon (MWF)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTue"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue (TTSS)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWed"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed (MWF)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThu"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu (TTSS)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFri"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri (MWF)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSat"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat (TTSS)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSun"
                    style="@style/StudyOS.Chip.DayFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sun (Audit-Only)" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Routine Tag Summary for Selected Day -->
        <TextView
            android:id="@+id/tvDayOverviewBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_card_bg"
            android:padding="10dp"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Standard Day: Costing 2x (2h18m) + Audit 2x (1h30m) + MWF Tuition (6–7 PM)" />

        <!-- Timetable RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTimetable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_timetable_schedule" />

    </LinearLayout>

    <!-- Floating Action Button to Add Activity -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add Block"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary"
        app:backgroundTint="@color/primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
